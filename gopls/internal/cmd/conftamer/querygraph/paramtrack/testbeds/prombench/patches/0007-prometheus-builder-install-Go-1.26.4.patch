From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emily Marx <emilykmarx@alumni.stanford.edu>
Date: Mon, 16 Nov 2026 20:23:27 -0800
Subject: [PATCH] prometheus-builder: install Go 1.26.4

paramtrack's images (prometheus/prombench-argmatch.Dockerfile and
paramtrack's modules/*/argmatch.Dockerfile) build FROM this image, tagged
upstream.py's BUILDER_TAG, and apply contexttrack's go-inlibrary.patch to
its Go. (This used to also apply go-conftamer-ancestry's legacy Go patch,
which logged every send's and receive's stacks; contexttrack replaced it.)
---
 tools/prometheus-builder/Dockerfile | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/tools/prometheus-builder/Dockerfile b/tools/prometheus-builder/Dockerfile
index 3d1ab82..13bdae6 100644
--- a/tools/prometheus-builder/Dockerfile
+++ b/tools/prometheus-builder/Dockerfile
@@ -1,5 +1,14 @@
 FROM quay.io/prometheus/golang-builder:1.26-base
 
+# Replace Go with this version: the one contexttrack's go-inlibrary.patch, which paramtrack's images apply on top, was
+# made against
+ARG GO_VERSION=1.26.4
+ENV GOTOOLCHAIN=local
+
+RUN rm -rf /usr/local/go && \
+    curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -C /usr/local -xz && \
+    go version
+
 RUN mkdir -p /go/src/github.com
 
 COPY ./build.sh /go/src/github.com/build.sh
