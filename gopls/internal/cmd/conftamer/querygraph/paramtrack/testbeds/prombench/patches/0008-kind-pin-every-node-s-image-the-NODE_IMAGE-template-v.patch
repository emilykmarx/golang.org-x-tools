From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emily Marx <emilykmarx@alumni.stanford.edu>
Date: Sun, 15 Nov 2026 19:12:52 -0800
Subject: [PATCH] kind: pin every node's image (the NODE_IMAGE template
 variable)

paramtrack instruments the API server (kube-apiserver), built from a fixed
Kubernetes version; the rest of the cluster must run the same version.
---
 prombench/manifests/cluster_kind.yaml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/prombench/manifests/cluster_kind.yaml b/prombench/manifests/cluster_kind.yaml
index 4807af1..104caba 100644
--- a/prombench/manifests/cluster_kind.yaml
+++ b/prombench/manifests/cluster_kind.yaml
@@ -1,7 +1,10 @@
 kind: Cluster
 apiVersion: kind.x-k8s.io/v1alpha4
+# Every node's Kubernetes version (the NODE_IMAGE template variable): paramtrack instruments the API server,
+# whose version must match the rest of the cluster's
 nodes:
   - role: control-plane
+    image: "{{ .NODE_IMAGE }}"
     # Mounted into the prometheus-meta pod (manifests/cluster-infra/3b_prometheus-meta.yaml),
     # where argmatch and contexttrack write their outputs.
     extraMounts:
@@ -14,6 +17,7 @@ nodes:
           kubeletExtraArgs:
             node-labels: "node-name=main-node,cloud.google.com/gke-nodepool=main-node"
   - role: worker
+    image: "{{ .NODE_IMAGE }}"
     kubeadmConfigPatches:
       - |
         kind: JoinConfiguration
@@ -21,6 +25,7 @@ nodes:
           kubeletExtraArgs:
             node-labels: "isolation=prometheus,node-name=prometheus-{{ .PR_NUMBER }},cloud.google.com/gke-nodepool=prometheus-{{ .PR_NUMBER }}"
   - role: worker
+    image: "{{ .NODE_IMAGE }}"
     kubeadmConfigPatches:
       - |
         kind: JoinConfiguration
@@ -28,6 +33,7 @@ nodes:
           kubeletExtraArgs:
             node-labels: "isolation=prometheus,node-name=prometheus-{{ .PR_NUMBER }},cloud.google.com/gke-nodepool=prometheus-{{ .PR_NUMBER }}"
   - role: worker
+    image: "{{ .NODE_IMAGE }}"
     kubeadmConfigPatches:
       - |
         kind: JoinConfiguration
-- 
2.34.1

