From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emily Marx <emilykmarx@alumni.stanford.edu>
Date: Thu, 12 Nov 2026 20:44:28 -0800
Subject: [PATCH] prometheus-meta: run paramtrack's image,
 prometheus-conftamer:v3.2.1

Ported from the fork's 7a65244 (prometheus-meta only).
---
 prombench/manifests/cluster-infra/3b_prometheus-meta.yaml | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml b/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml
index 818a962..37876cf 100644
--- a/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml
+++ b/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml
@@ -201,7 +201,9 @@ spec:
       securityContext:
         runAsUser: 0
       containers:
-      - image: quay.io/prometheus/prometheus:v3-distroless
+      # Built and loaded into the main node by paramtrack (Prometheus under argmatch and contexttrack)
+      - image: prometheus-conftamer:v3.2.1
+        imagePullPolicy: IfNotPresent
         args:
         - "--config.file=/etc/prometheus/config/prometheus.yaml"
         - "--storage.tsdb.path=/data"
