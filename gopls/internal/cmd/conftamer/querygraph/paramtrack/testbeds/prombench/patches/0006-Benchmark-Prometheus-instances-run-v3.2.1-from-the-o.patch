From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emily Marx <emilykmarx@alumni.stanford.edu>
Date: Thu, 12 Nov 2026 20:44:36 -0800
Subject: [PATCH] Benchmark Prometheus instances: run v3.2.1 from the official
 image

From the fork's 7a65244 and 04faa09. The PR instance runs
quay.io/prometheus/prometheus:v3.2.1 (RELEASE is v3.2.1 too) instead of
building PR_NUMBER from source in an init container on every pod start,
which made it slow to start. Both instances get
--enable-feature=metadata-wal-records, which v3.2.1 needs for the PRW 2.0
remote_write the configs use, and imagePullPolicy IfNotPresent.
---
 .../5_prometheus-test-pr_deployment.yaml      | 31 ++++---------------
 .../5_prometheus-test-release_deployment.yaml |  6 ++--
 2 files changed, 10 insertions(+), 27 deletions(-)

diff --git a/prombench/manifests/prombench/benchmark/5_prometheus-test-pr_deployment.yaml b/prombench/manifests/prombench/benchmark/5_prometheus-test-pr_deployment.yaml
index deb0353..b929ea5 100644
--- a/prombench/manifests/prombench/benchmark/5_prometheus-test-pr_deployment.yaml
+++ b/prombench/manifests/prombench/benchmark/5_prometheus-test-pr_deployment.yaml
@@ -762,21 +762,6 @@ spec:
       securityContext:
         runAsUser: 0
       initContainers:
-      - name: prometheus-builder
-        image: docker.io/prominfra/prometheus-builder:master
-        imagePullPolicy: Always
-        env:
-        - name: PR_NUMBER
-          value: "{{ .PR_NUMBER }}"
-        - name: VOLUME_DIR
-          value: "/prometheus-builder" # same as mountPath
-        - name: GITHUB_ORG
-          value: "{{ .GITHUB_ORG }}"
-        - name: GITHUB_REPO
-          value: "{{ .GITHUB_REPO }}"
-        volumeMounts:
-        - name: prometheus-executable
-          mountPath: /prometheus-builder
       # Check if the release Prometheus is already up via /-/ready (rolling
       # restart case). If so, skip sync and start immediately. Otherwise listen
       # on port 9090 and wait until both peers have connected, so both
@@ -800,10 +785,8 @@ spec:
           done
       containers:
       - name: prometheus
-        image: quay.io/prometheus/busybox:latest
-        imagePullPolicy: Always
-        # The prometheus-builder takes a while to build
-        # so make sure to start it before the release deployment.
+        image: quay.io/prometheus/prometheus:v3.2.1
+        imagePullPolicy: IfNotPresent
         # Mark it ready only when prometheus is started.
         # This way we have the least time difference in the scraped metrics.
         readinessProbe:
@@ -812,12 +795,14 @@ spec:
           initialDelaySeconds: 30
           periodSeconds: 2
           failureThreshold: 30
-        command: ["/usr/bin/prometheus"]
+        command: ["/bin/prometheus"]
         args: [
           "--web.external-url=http://{{ .DOMAIN_NAME }}/{{ .PR_NUMBER }}/prometheus-pr",
           "--storage.tsdb.path=/prometheus",
           "--config.file=/etc/prometheus/prometheus.yml",
-          "--log.level=info"
+          "--log.level=info",
+          # needed for Prom 3.2.1
+          "--enable-feature=metadata-wal-records"
         ]
         resources:
           requests:
@@ -830,8 +815,6 @@ spec:
           mountPath: /etc/prometheus
         - name: instance-ssd
           mountPath: /prometheus
-        - name: prometheus-executable
-          mountPath: /usr/bin
         ports:
         - name: prom-web
           containerPort: 9090
@@ -843,8 +826,6 @@ spec:
         hostPath:
           # /mnt is where GKE keeps it's SSD.
           path: /mnt/disks/ssd0
-      - name: prometheus-executable
-        emptyDir: {}
       terminationGracePeriodSeconds: 300
       nodeSelector:
         node-name: prometheus-{{ .PR_NUMBER }}
diff --git a/prombench/manifests/prombench/benchmark/5_prometheus-test-release_deployment.yaml b/prombench/manifests/prombench/benchmark/5_prometheus-test-release_deployment.yaml
index 3da3e87..4f8e13c 100644
--- a/prombench/manifests/prombench/benchmark/5_prometheus-test-release_deployment.yaml
+++ b/prombench/manifests/prombench/benchmark/5_prometheus-test-release_deployment.yaml
@@ -787,13 +787,15 @@ spec:
       containers:
       - name: prometheus
         image: quay.io/prometheus/prometheus:{{ .RELEASE }}
-        imagePullPolicy: Always
+        imagePullPolicy: IfNotPresent
         command: [ "/bin/prometheus" ]
         args: [
           "--web.external-url=http://{{ .DOMAIN_NAME }}/{{ .PR_NUMBER }}/prometheus-release",
           "--storage.tsdb.path=/prometheus",
           "--config.file=/etc/prometheus/prometheus.yml",
-          "--log.level=info"
+          "--log.level=info",
+          # needed for Prom 3.2.1
+          "--enable-feature=metadata-wal-records"
         ]
         resources:
           requests:
