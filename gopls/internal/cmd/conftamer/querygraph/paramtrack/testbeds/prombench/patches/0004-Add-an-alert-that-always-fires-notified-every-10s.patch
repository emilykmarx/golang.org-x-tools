From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emily Marx <emilykmarx@alumni.stanford.edu>
Date: Mon, 16 Nov 2026 21:04:35 -0800
Subject: [PATCH] Add an alert that always fires, notified every 10s

prometheus-meta sends Alertmanager an alert per benchmark Prometheus
(always firing, from its first scrape of it), resent every 5s, and
Alertmanager notifies amgithubnotifier on it every 10s, so a run sees
prometheus-meta -> Alertmanager and Alertmanager -> amgithubnotifier
messages. (It was a flapping alert on the benchmark instances' query
latency, cherry-picked from the fork's b38f120; it fired only minutes
after prometheus-meta's restart, which a run's workload could miss.)
---
 .../cluster-infra/3b_prometheus-meta.yaml         | 15 +++++++++++++++
 .../cluster-infra/5a_alertmanager_deployment.yaml |  8 ++++++++
 2 files changed, 23 insertions(+)

diff --git a/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml b/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml
index 818a962..d2b070f 100644
--- a/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml
+++ b/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml
@@ -29,6 +29,19 @@ data:
           description: >
             Benchmark tests are running for {{"{{"}} $value {{"}}"}} days!
             If this is intended ignore this message otherwise you can cancel it by commenting: `/prombench cancel`
+    - name: benchmark-prometheus-always-firing
+      # Checked every 10s
+      interval: 10s
+      rules:
+      # Fires for each benchmark Prometheus from prometheus-meta's first scrape of it, so every run (whose workload
+      # starts soon after prometheus-meta's restart) sees alerts sent and notified.
+      - alert: benchmarkPrometheusAlwaysFiring
+        expr: up{job="prometheus",namespace=~"prombench-[0-9]+",prometheus=~"test-.*"} >= 0
+        labels:
+          severity: info
+        annotations:
+          description: >
+            Always firing for {{"{{"}} $labels.prometheus {{"}}"}}, so Alertmanager has something to notify.
 ---
 apiVersion: v1
 kind: ConfigMap
@@ -207,6 +220,8 @@ spec:
         - "--storage.tsdb.path=/data"
         - "--storage.tsdb.retention.size=500GB"  # 50% of the total storage available.
         - "--web.enable-lifecycle"
+        # Time to wait between re-sending active alerts to Alertmanager (default is 1m): every few seconds.
+        - "--rules.alert.resend-delay=5s"
         - "--web.external-url=http://{{ .DOMAIN_NAME }}/prometheus-meta"
         - "--enable-feature=promql-duration-expr"
         - "--enable-feature=promql-extended-range-selectors"
diff --git a/prombench/manifests/cluster-infra/5a_alertmanager_deployment.yaml b/prombench/manifests/cluster-infra/5a_alertmanager_deployment.yaml
index a9c818c..967c0f6 100644
--- a/prombench/manifests/cluster-infra/5a_alertmanager_deployment.yaml
+++ b/prombench/manifests/cluster-infra/5a_alertmanager_deployment.yaml
@@ -13,6 +13,14 @@ data:
       group_interval: 5m
       repeat_interval: 2d
       receiver: amgithubnotifier-bridge
+      routes:
+      # Notify on the always-firing alert several times a minute, per test Prometheus.
+      - matchers:
+        - alertname="benchmarkPrometheusAlwaysFiring"
+        group_by: ['alertname', 'namespace', 'prometheus']
+        group_wait: 10s
+        group_interval: 10s
+        repeat_interval: 10s
 
     receivers:
     - name: amgithubnotifier-bridge
