From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Emily Marx <emilykmarx@alumni.stanford.edu>
Date: Thu, 12 Nov 2026 20:44:16 -0800
Subject: [PATCH] Mount the host's argmatch output directory in prometheus-meta
 at /argmatch-out

Ported from the fork's 8cfc605 (the mount only; the host path is the
ARGMATCH_OUT template variable instead of a fixed path).
---
 prombench/manifests/cluster-infra/3b_prometheus-meta.yaml | 8 ++++++++
 prombench/manifests/cluster_kind.yaml                     | 5 +++++
 2 files changed, 13 insertions(+)

diff --git a/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml b/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml
index 352cfa5..818a962 100644
--- a/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml
+++ b/prombench/manifests/cluster-infra/3b_prometheus-meta.yaml
@@ -223,6 +223,8 @@ spec:
         - name: storage
           mountPath: /data
           subPath: prometheus-data
+        - name: argmatch-out
+          mountPath: /argmatch-out
         ports:
         - name: prom-web
           containerPort: 9090
@@ -236,6 +238,12 @@ spec:
       - name: storage
         persistentVolumeClaim:
           claimName: prometheus-meta
+      - name: argmatch-out
+        hostPath:
+          # Path on the kind node; manifests/cluster_kind.yaml mounts the host's
+          # argmatch output directory there on the main-node (control-plane) node.
+          path: /argmatch-out
+          type: Directory
       terminationGracePeriodSeconds: 300
       nodeSelector:
         cloud.google.com/gke-nodepool: main-node
diff --git a/prombench/manifests/cluster_kind.yaml b/prombench/manifests/cluster_kind.yaml
index 0e482b2..4807af1 100644
--- a/prombench/manifests/cluster_kind.yaml
+++ b/prombench/manifests/cluster_kind.yaml
@@ -2,6 +2,11 @@ kind: Cluster
 apiVersion: kind.x-k8s.io/v1alpha4
 nodes:
   - role: control-plane
+    # Mounted into the prometheus-meta pod (manifests/cluster-infra/3b_prometheus-meta.yaml),
+    # where argmatch and contexttrack write their outputs.
+    extraMounts:
+      - hostPath: "{{ .ARGMATCH_OUT }}"
+        containerPath: /argmatch-out
     kubeadmConfigPatches:
       - |
         kind: InitConfiguration
